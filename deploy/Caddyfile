http://{$DOMAIN} {
	encode gzip zstd

	request_body {
		max_size 20MB
	}

	handle_path /storage/* {
		root * /srv/storage
		file_server
	}

	handle /api* {
		reverse_proxy backend:8000
	}

	handle /sanctum* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
