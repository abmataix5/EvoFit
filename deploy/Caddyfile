# Dirección del sitio (SITE_ADDRESS, por defecto = DOMAIN desde docker-compose.prod.yml).
#   - "evofit.example.com"        -> HTTPS automático (Let's Encrypt) + redirección de http.
#   - "http://evofit.example.com" -> solo HTTP en el origen. Úsalo SOLO detrás de Cloudflare
#     en modo SSL "Flexible" (Cloudflare termina el HTTPS y habla HTTP con este servidor).
#     Mejor aún: Cloudflare en "Full (strict)" y SITE_ADDRESS sin http:// (HTTPS en origen).
{
	servers {
		# Rangos de Cloudflare (https://www.cloudflare.com/ips/): solo si la petición viene
		# de ellos se confía en CF-Connecting-IP / X-Forwarded-* para saber la IP real.
		# Sin Cloudflare no afecta: la IP del cliente es la de la conexión.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# Si SITE_ADDRESS trae más direcciones (www, la IP antigua), todas llevan a la principal.
	# Con una sola dirección no hace nada.
	@other not host {$DOMAIN}
	redir @other https://{$DOMAIN}{uri} permanent

	request_body {
		max_size 20MB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# strict-origin-when-cross-origin: el navegador sigue mandando Referer en las
		# peticiones al mismo origen (Sanctum lo usa para reconocer la SPA).
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# HSTS solo cuando la conexión del navegador es HTTPS (directa o vía Cloudflare).
	@https {
		header X-Forwarded-Proto https
	}
	header @https Strict-Transport-Security "max-age=31536000"
	@tls protocol https
	header @tls Strict-Transport-Security "max-age=31536000"

	# Las fotos de progreso ya no se sirven aquí: son privadas y van por
	# /api/v1/progress/photos/{id}/image (con sesión y comprobación de dueño).

	handle /api* {
		reverse_proxy backend:8000 {
			# IP real del cliente para Laravel (rate limiting de login, logs).
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /sanctum* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Fotos de la biblioteca de ejercicios: estáticas, cacheadas 30 días y con 404 real
	# (sin el try_files de abajo, que devolvería index.html para una foto que no existe).
	handle /media/* {
		root * /srv/www
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		root * /srv/www
		try_files {path} /index.html

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@html not path /assets/* /favicon.ico /favicon-32.png /icon-192.png /apple-touch-icon.png /logo.png /site.webmanifest
		header @html Cache-Control "no-cache, no-store, must-revalidate"

		file_server
	}
}
