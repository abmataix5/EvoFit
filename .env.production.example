# Copia este archivo como .env en el servidor y cambia los valores.
# NO subas el .env real a git.

# --- Sin dominio (solo IP) — HTTP ---
DOMAIN=TU_IP
# Obligatorio con IP: "http://" hace que Caddy sirva solo HTTP (sin certificado).
SITE_ADDRESS=http://TU_IP
APP_URL=http://TU_IP
SANCTUM_STATEFUL_DOMAINS=TU_IP
CORS_ALLOWED_ORIGINS=http://TU_IP
SESSION_DOMAIN=
# Obligatorio con HTTP: si es true el navegador no guarda la cookie y no se puede entrar.
SESSION_SECURE_COOKIE=false

DB_ROOT_PASSWORD=cambia-esto
DB_DATABASE=evofit
DB_USERNAME=evofit
DB_PASSWORD=cambia-esto-tambien

# --- Correo (avisos de solicitudes de amistad) ---
# Sin esto los emails se escriben en el log del backend en vez de enviarse.
# Ejemplo con Brevo (gratis hasta 300/día): smtp-relay.brevo.com, puerto 587.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-usuario-smtp
# MAIL_PASSWORD=tu-clave-smtp
# MAIL_FROM_ADDRESS=no-reply@tudominio.com
# MAIL_FROM_NAME=EvoFit

# Opcionales
# PHP_CLI_SERVER_WORKERS=4
# BACKUP_KEEP_DAYS=14

# --- Cuando tengas dominio (HTTPS automático con Let's Encrypt) ---
# DOMAIN=tudominio.com
# (quita SITE_ADDRESS)
# APP_URL=https://tudominio.com
# SANCTUM_STATEFUL_DOMAINS=tudominio.com
# CORS_ALLOWED_ORIGINS=https://tudominio.com
# SESSION_DOMAIN=tudominio.com
# SESSION_SECURE_COOKIE=true
